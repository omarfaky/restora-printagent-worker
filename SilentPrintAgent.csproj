<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- يظل net9.0 (وليس net9.0-windows): استدعاءات winspool معرّفة عندنا بـ DllImport
         ولا تمس أي API موسوم [SupportedOSPlatform] فلا تظهر تحذيرات CA1416،
         والـ CI يبني الحل كله على Linux. المشروع يعمل على ويندوز فقط وقت التشغيل. -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SilentPrintAgent</AssemblyName>
    <RootNamespace>SilentPrintAgent</RootNamespace>
    <DefaultItemExcludesInProjectFolder>$(DefaultItemExcludesInProjectFolder);tests/**;tests/**/*;samples/**;samples/**/*</DefaultItemExcludesInProjectFolder>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="samples/**/*.cs" />
    <Compile Remove="tests/**/*.cs" />
    <!-- خرائط الأخطاء والمساعدات النقية تظل internal ولا تُرفع للـ public API
         لمجرد اختبارها؛ مشروع الاختبارات وحده يراها. -->
    <InternalsVisibleTo Include="SilentPrintAgent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- الخط يسافر داخل الـ assembly: خطوط أجهزة الكاشير غير مضمونة،
         وخط ناقص يعني إيصالا فارغا. Noto Naskh Arabic برخصة SIL OFL
         التي تسمح بالتوزيع، ونسخة الرخصة ترافقه كما تشترط. -->
    <EmbeddedResource Include="Resources\Fonts\NotoNaskhArabic-Regular.ttf" />
    <EmbeddedResource Include="Resources\receipt-layout.json" />
    <Content Include="Resources\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" />
  </ItemGroup>

  <!-- GitHub Actions runs the test suite on Linux. Keep the Windows native
       asset for the production print agent and add the matching Linux asset
       only when restore runs on a Linux host. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.0" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.1" />
  </ItemGroup>

</Project>
