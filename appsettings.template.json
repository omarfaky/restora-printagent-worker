{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PrintAgent": {
    "DataDirectory": "C:\\ProgramData\\SilentPrintAgent\\data",
    "LocalApiPort": 5055,
    "LocalToken": "replace-with-a-long-random-token",
    "ClientId": "default",
    "AllowedOrigins": ["https://your-frontend.example.com"],
    "AllowRawEscPos": false,
    "Printers": [
      {
        "PrinterId": "receipt",
        "DisplayName": "Receipt printer",
        "ConnectionType": "NetworkEscPos",
        "Address": "192.168.1.100",
        "Port": 9100,
        "PaperWidthMm": 80,
        "DefaultCopies": 1,
        "CashDrawerEnabled": true,
        "Enabled": true
      }
    ]
  }
}
